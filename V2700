### 5. `src/api.js`

```javascript
const express = require('express');
const cors = require('cors');
const { queues } = require('./queue/config');
const app = express();
app.use(cors());
app.use(express.json());

app.post('/api/company/cycle', async (req, res) => {
    await queues.intelligence.add('scan-trends', { strategy: { aggressiveness: 0.75 } });
    res.json({ success: true, message: "Cycle initiated" });
});

app.listen(3000, () => console.log("API Online on 3000"));

```

