### 8. `src/media/ffmpegEngine.js`

```javascript
const ffmpeg = require('fluent-ffmpeg');
const path = require('path');

class MediaEngine {
    static async render(content, jobId) {
        return new Promise((resolve, reject) => {
            const outputPath = path.join(__dirname, `../../output/v2700_${jobId}.mp4`);
            ffmpeg()
                .input('color=c=black:s=1080x1920:d=5')
                .inputFormat('lavfi')
                .complexFilter([`drawtext=text='${content.title}':fontcolor=white:fontsize=72:x=(w-text_w)/2:y=(h-text_h)/2`])
                .outputOptions(['-c:v libx264', '-pix_fmt yuv420p'])
                .save(outputPath)
                .on('end', resolve)
                .on('error', reject);
        });
    }
}
module.exports = MediaEngine;

```

