```javascript
const { Queue } = require('bullmq');
const Redis = require('ioredis');
const connection = new Redis({ host: process.env.REDIS_HOST || '127.0.0.1' });

module.exports = { 
    connection, 
    queues: { 
        intelligence: new Queue('IntelligenceDept', { connection }),
        production: new Queue('ProductionDept', { connection }) 
    } 
};

